# Local backend configuration. Replace placeholders; never commit real secrets.
DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PASSWORD_PEPPER=replace-with-a-separate-random-secret-at-least-32-characters
JWT_ISSUER=tutorinn
JWT_AUDIENCE=tutorinn-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-random-secret-at-least-32-characters
# Keep legacy demo mode for local MVP development. Production/Vercel defaults it off.
ENABLE_DEMO_MODE=true
# Optional legacy demo Admin key; not used for authenticated Beta Admin access.
ADMIN_API_KEY=

# Optional SMTP delivery for approved password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
FRONTEND_URL=
