# Local backend configuration. Copy to .env and replace every CHANGE_ME value.
# Never commit .env or paste generated secrets into chat.
# Leave DATABASE_URL empty for the local SQLite fallback. For PostgreSQL, use the
# Supabase transaction-pooler URL; Vercel POSTGRES_URL and POSTGRES_PRISMA_URL are also accepted.
DATABASE_URL=
JWT_SECRET=CHANGE_ME
PASSWORD_PEPPER=CHANGE_ME
JWT_ISSUER=tutorinn
JWT_AUDIENCE=tutorinn-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME
# Keep legacy demo mode for local MVP development. Production/Vercel defaults it off.
ENABLE_DEMO_MODE=true
# Optional legacy demo Admin key; not used for authenticated Beta Admin access.
ADMIN_API_KEY=

# Scheduled activity cleanup. Use a separate generated secret if running the scheduler locally.
CRON_SECRET=CHANGE_ME
# Successful-login and temporary auth-attempt activity retention; 0 disables cleanup.
ACTIVITY_RETENTION_DAYS=90
