# Local backend configuration. Replace placeholders; never commit real secrets.
DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=tutorinn
JWT_AUDIENCE=tutorinn-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-random-secret-at-least-32-characters
# Keep legacy demo mode for local MVP development. Production/Vercel defaults it off.
ENABLE_DEMO_MODE=true
# Optional legacy demo Admin key; not used for authenticated Beta Admin access.
ADMIN_API_KEY=
