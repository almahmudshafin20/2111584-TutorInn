# Local backend configuration. Copy to .env and replace every CHANGE_ME value.
# Never commit .env or paste generated secrets into chat.
# Leave DATABASE_URL empty for the local SQLite fallback. For PostgreSQL, use the
# Supabase transaction-pooler URL; Vercel POSTGRES_URL and POSTGRES_PRISMA_URL are also accepted.
DATABASE_URL=
JWT_SECRET=CHANGE_ME
PASSWORD_PEPPER=CHANGE_ME
JWT_ISSUER=tutorinn
JWT_AUDIENCE=tutorinn-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Keep legacy demo mode for local MVP development. Production/Vercel defaults it off.
ENABLE_DEMO_MODE=true
# Deployment mode. Set to production on the hosted API; Vercel also sets VERCEL=1 automatically.
ENVIRONMENT=development
# Exact frontend origin(s) allowed for credentialed browser requests, comma-separated, no paths.
# FRONTEND_ORIGIN is used as the fallback for TRUSTED_ORIGINS and for links in notification emails.
TRUSTED_ORIGINS=
FRONTEND_ORIGIN=
# Maximum security events written per client per minute (flood protection).
SECURITY_EVENT_MAX_PER_MINUTE=60
# Demo seed script only (scripts/seed_demo_accounts.py): demo-only password, at least 12 characters.
# Never set this to a real personal password and never run the seed against production.
DEMO_PASSWORD=
# The First Admin is created interactively with scripts/create_first_admin.py; no environment secret is read.
# Scheduled activity cleanup. Use a separate generated secret if running the scheduler locally.
CRON_SECRET=CHANGE_ME
# Successful-login and temporary auth-attempt activity retention; 0 disables cleanup.
ACTIVITY_RETENTION_DAYS=90

# Shared SMTP email provider for account deletion notices, email verification and password reset links
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Password reset and email verification links require an HTTPS public app URL and working SMTP.
PUBLIC_APP_URL=
PASSWORD_RESET_REQUEST_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_WINDOW_SECONDS=3600
PASSWORD_RESET_COMPLETE_MAX_ATTEMPTS=10
PASSWORD_RESET_COMPLETE_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_REQUEST_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_REQUEST_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_COMPLETE_MAX_ATTEMPTS=10
EMAIL_VERIFICATION_COMPLETE_WINDOW_SECONDS=3600
FIRST_ADMIN_TRANSFER_MAX_ATTEMPTS=5
FIRST_ADMIN_TRANSFER_WINDOW_SECONDS=3600
